# Development. Copy to .env at the repo root; `bun run dev`, `db:migrate` and `db:seed` read
# it, and `bun run worktree:setup` writes a worktree's own from this file. (env.example is
# for self-hosting with Docker Compose, not for this.)
#
# Every value here is safe to run: email goes to the fake backend, objects to temp/, and no
# cloud key is set. Never put a production database, bucket or key in a development .env.

# Ports. The main checkout uses this block; worktree:setup gives each worktree the next
# free one (3100, 3200, ...). The URLs the apps use to reach each other are built from
# these, so set a port rather than a URL.
WEB_PORT=3000
SITE_PORT=3001
API_PORT=3005
BUILDER_PORT=3006

# Any local Postgres 18 and Redis 7. db:migrate and db:seed refuse a host other than
# localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relayit
REDIS_URL=redis://localhost:6379
# Goes in front of every Redis key, so checkouts sharing one Redis keep apart. A
# worktree's is wt:<worktree>:.
REDIS_KEY_PREFIX=

# Local only; deploys set their own (`openssl rand -base64 32`). worktree:setup generates
# both for a worktree.
BETTER_AUTH_SECRETS=1:local-development-secret-not-for-deploys
TEMPLATING_BUILDER_SECRET=local-development-builder-secret

# fake: sends are accepted and never leave this machine; Domains verify at once; mail to
# bounce@simulator.amazonses.com bounces and complaint@simulator.amazonses.com complains.
# ses sends through the Provider rows' AWS credentials: only with Ted's go-ahead.
EMAIL_BACKEND=fake
# local: templates and attachments are files under temp/object-storage. s3 needs the
# S3_* variables below.
OBJECT_STORAGE=local

LOG_LEVEL=Info

# Off unless set. Each reaches a real account: leave them unset unless Ted asks.
# CF_API_TOKEN=          Cloudflare DNS for Sandbox Domains (with CF_ROOT_DOMAIN, CF_ZONE_ID)
# STRIPE_SECRET_KEY=     Plans and billing (with STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_*)
# GITHUB_CLIENT_ID=      GitHub sign-in (with GITHUB_CLIENT_SECRET)
# S3_ENDPOINT=           A bucket, with OBJECT_STORAGE=s3 (and S3_BUCKET, S3_REGION,
#                        S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY)
