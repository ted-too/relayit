{
  "name": "relayit",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@babel/core": "^8.1.2",
      "@effect-aws/client-s3": "2.0.0",
      "@effect/platform-bun": "4.1.4",
      "@effect/sql-pg": "4.1.4",
      "@effect/tsgo": "^0.70.0",
      "@effect/vitest": "4.1.4",
      "@remixicon/react": "^4.9.0",
      "@rolldown/plugin-babel": "^0.3.1",
      "@tailwindcss/vite": "^4.3.5",
      "@tanstack/react-hotkeys": "^0.27.0",
      "@tanstack/react-query": "^5.107.1",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.5",
      "@tanstack/react-table": "^8.21.3",
      "@types/bun": "^1.4.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "better-auth": "^1.7.25",
      "drizzle-orm": "1.0.0-rc.5",
      "effect": "4.1.4",
      "nitro": "3.0.261103-rc",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "stripe": "^22.6.2",
      "typeid-js": "^1.2.0",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
      "vite-plus": "1.7.0",
      "vitest": "5.1.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "dev": "vp run -r --parallel dev",
    "build": "vp run --filter './apps/*' build",
    "typecheck": "vp run -r typecheck",
    "test": "bun --no-env-file tooling/scripts/src/test.ts",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "knip": "knip --no-config-hints",
    "db:generate": "vp run --filter @repo/persistence db:generate",
    "db:migrate": "bun --no-env-file tooling/scripts/src/db-migrate.ts",
    "db:seed": "bun --no-env-file tooling/scripts/src/db-seed.ts",
    "worktree:setup": "bash tooling/scripts/worktree-setup.sh",
    "worktree:prune": "bash tooling/scripts/worktree-prune.sh"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "6.45.1",
    "semantic-release": "^25.0.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "effect": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "sharp"
  ]
}
