{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "paths": {
      "@repo/templating": ["./src/index.ts"],
      "@repo/templating/*": ["./src/*"],
      "@repo/object-storage": ["../object-storage/src/index.ts"],
      "@repo/object-storage/*": ["../object-storage/src/*"],
      "@repo/persistence/*": ["../persistence/src/*"],
      "@repo/redis": ["../redis/src/index.ts"],
      "@repo/redis/*": ["../redis/src/*"],
      "@repo/template-render": ["../template-render/src/index.ts"],
      "@repo/template-render/*": ["../template-render/src/*"]
    }
  }
}
