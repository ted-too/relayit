{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RelayitDomainIdentities",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes",
        "ses:ListResourceTenants"
      ],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "RelayitSend",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:*:ACCOUNT_ID:identity/*",
        "arn:aws:ses:*:ACCOUNT_ID:configuration-set/relayit-delivery-events"
      ]
    },
    {
      "Sid": "RelayitConfigurationSet",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:CreateConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination"
      ],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:configuration-set/relayit-delivery-events"
    },
    {
      "Sid": "RelayitProjectTenants",
      "Effect": "Allow",
      "Action": ["ses:CreateTenant", "ses:GetTenant", "ses:GetReputationEntity"],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:tenant/relayit-*"
    },
    {
      "Sid": "RelayitListTenants",
      "Effect": "Allow",
      "Action": "ses:ListTenants",
      "Resource": "*"
    },
    {
      "Sid": "RelayitAttachToProjectTenant",
      "Effect": "Allow",
      "Action": "ses:CreateTenantResourceAssociation",
      "Resource": [
        "arn:aws:ses:*:ACCOUNT_ID:tenant/relayit-*",
        "arn:aws:ses:*:ACCOUNT_ID:identity/*",
        "arn:aws:ses:*:ACCOUNT_ID:configuration-set/relayit-delivery-events"
      ]
    },
    {
      "Sid": "RelayitDetachIdentityFromProjectTenant",
      "Effect": "Allow",
      "Action": "ses:DeleteTenantResourceAssociation",
      "Resource": [
        "arn:aws:ses:*:ACCOUNT_ID:tenant/relayit-*",
        "arn:aws:ses:*:ACCOUNT_ID:identity/*"
      ]
    },
    {
      "Sid": "RelayitNotificationTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:sns:*:ACCOUNT_ID:relayit-delivery-*"
    },
    {
      "Sid": "RelayitTenantStatusEvents",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:PutTargets"],
      "Resource": "arn:aws:events:*:ACCOUNT_ID:rule/relayit-tenant-status-*"
    }
  ]
}
