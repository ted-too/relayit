{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RelayITSesAccount",
      "Effect": "Allow",
      "Action": "ses:GetAccount",
      "Resource": "*"
    },
    {
      "Sid": "RelayITSesIdentitiesAndSend",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes",
        "ses:SendEmail"
      ],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "RelayITSesConfigurationSets",
      "Effect": "Allow",
      "Action": ["ses:CreateConfigurationSet", "ses:CreateConfigurationSetEventDestination"],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:configuration-set/relayit-default"
    },
    {
      "Sid": "RelayITSesInboundReceiving",
      "Effect": "Allow",
      "Action": [
        "ses:CreateReceiptRuleSet",
        "ses:CreateReceiptRule",
        "ses:DescribeReceiptRuleSet",
        "ses:SetActiveReceiptRuleSet"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RelayITSesTenantStatus",
      "Effect": "Allow",
      "Action": ["ses:GetTenant", "ses:GetReputationEntity"],
      "Resource": "arn:aws:ses:*:ACCOUNT_ID:tenant/relayit-*"
    },
    {
      "Sid": "RelayITTenantStatusEvents",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:PutTargets"],
      "Resource": "arn:aws:events:*:ACCOUNT_ID:rule/relayit-tenant-status-*"
    },
    {
      "Sid": "RelayITSnsWebhooks",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": "arn:aws:sns:*:ACCOUNT_ID:relayit-*"
    }
  ]
}
