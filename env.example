# RelayIt Configuration, for self-hosting with Docker Compose.
# Copy this file to .env and fill in real values before `docker compose up`.
# Required vars match the apps/api and apps/worker env schemas; web needs only API_URL.
# Developing Relayit instead? Copy .env.example (docs/operations/development.md).

# =======================
# Images
# =======================
# ghcr.io/ted-too/relayit-{api,worker,web} — see https://github.com/ted-too/relayit/releases
IMAGE_TAG=alpha

# =======================
# Public URLs
# =======================
# API_URL is the api's public URL (e.g. https://api.example.com): the API, sign-in, the
# GitHub callback, Stripe's webhook and unsubscribe links are there, and the worker points
# SES notifications at it. The dashboard calls it from the browser.
# APP_URL is the dashboard's public URL (e.g. https://app.example.com): the one origin the
# api lets call it with the session cookie, and where sign-in returns to.
# Both must be on one site: two subdomains of one domain, or localhost on two ports.
API_URL=http://localhost:3005
APP_URL=http://localhost:3000
# Optional: a parent domain for the session cookie (example.com), so other subdomains
# can see a visitor is signed in. Unset, the cookie stays on the api's host.
# AUTH_COOKIE_DOMAIN=example.com
# Optional: the header your reverse proxy puts the visitor's IP in (X-Real-IP from nginx or
# Railway, CF-Connecting-IP from Cloudflare), so sign-in is rate limited per visitor. Name
# only a header the proxy overwrites and keep the api reachable only through it, or a
# visitor can send their own. Unset, every visitor shares one sign-in rate limit.
# CLIENT_IP_HEADER=X-Real-IP

# =======================
# api and worker
# =======================
LOG_LEVEL=info

# =======================
# Database (Postgres 18 in compose)
# =======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=relayit
# Override if not using the compose postgres service:
# DATABASE_URL=postgres://user:pass@host:5432/relayit?sslmode=require

# =======================
# Redis
# =======================
REDIS_URL=redis://redis:6379

# =======================
# Amazon SES (api and worker)
# =======================
# The SES account all email goes through: an IAM user allowed ses:* and the SNS calls the
# worker makes at startup. SES_REGIONS is comma-separated; new Domains are registered in
# the first, so keep the first where your existing Domains were registered.
SES_REGIONS=us-east-1
SES_ACCESS_KEY_ID=your-ses-access-key-id
SES_SECRET_ACCESS_KEY=your-ses-secret-access-key

# =======================
# Auth + DKIM key sealing
# =======================
# Versioned secrets: `1:current` or `2:new,1:old` (first = current).
# Used by better-auth and for sealing DKIM private keys.
# openssl rand -base64 32
BETTER_AUTH_SECRETS=1:your-very-secure-secret-key-32-chars-min

# =======================
# S3-compatible object storage
# Bunny: use its regional S3 endpoint/region and the storage zone name as both
# access key ID and bucket; the storage zone password is the secret access key.
# =======================
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=relayit
