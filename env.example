# RelayIt Configuration, for self-hosting with Docker Compose.
# Copy this file to .env and fill in real values before `docker compose up`.
# Required vars match the apps/api, apps/worker and apps/web env schemas.
# Developing Relayit instead? Copy .env.example (docs/operations/development.md).

# =======================
# Images
# =======================
# ghcr.io/ted-too/relayit-{api,worker,web} — see https://github.com/ted-too/relayit/releases
IMAGE_TAG=alpha

# =======================
# Public URLs
# =======================
# API_URL → api, worker (where SES notifications are pointed) and web API_URL
# WEB_URL → worker APP_URL (unsubscribe links) + web VITE_BASE_URL
API_URL=http://localhost:3005
WEB_URL=http://localhost:3000

# =======================
# api and worker
# =======================
LOG_LEVEL=info

# =======================
# Database (Postgres 18 in compose)
# =======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=relayit
# Override if not using the compose postgres service:
# DATABASE_URL=postgres://user:pass@host:5432/relayit?sslmode=require

# =======================
# Redis
# =======================
REDIS_URL=redis://redis:6379

# =======================
# Auth + credential sealing
# =======================
# Versioned secrets: `1:current` or `2:new,1:old` (first = current).
# Used by better-auth and for sealing provider credentials / DKIM keys.
# openssl rand -base64 32
BETTER_AUTH_SECRETS=1:your-very-secure-secret-key-32-chars-min

# =======================
# S3-compatible object storage
# Bunny: use its regional S3 endpoint/region and the storage zone name as both
# access key ID and bucket; the storage zone password is the secret access key.
# =======================
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=relayit
