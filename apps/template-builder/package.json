{
  "name": "@repo/template-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file ../../tooling/scripts/src/with-env.ts --app builder bun --no-env-file run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./build --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun --no-env-file test",
    "start": "bun ./src/index.ts"
  },
  "dependencies": {
    "@repo/object-storage": "workspace:*",
    "@repo/persistence": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/templating": "workspace:*",
    "effect": "catalog:"
  }
}
