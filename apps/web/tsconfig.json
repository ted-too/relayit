{
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".output"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/contracts/*": ["../../packages/contracts/src/*"],
      "@repo/persistence/*": ["../../packages/persistence/src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
