{
  "name": "@repo/api",
  "module": "src/index.js",
  "portless": {
    "name": "api.relayit",
    "script": "dev:app"
  },
  "version": "1.0.50",
  "scripts": {
    "dev": "portless",
    "dev:app": "bun run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./build --target node; cp -r ./drizzle ./build/drizzle;",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@repo/template-render": "workspace:*",
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/client-ses": "^3.1079.0",
    "@aws-sdk/client-sesv2": "^3.1057.0",
    "@aws-sdk/client-sns": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@better-auth/api-key": "^1.6.13",
    "@better-auth/stripe": "^1.6.13",
    "@elysiajs/cors": "^1.4.2",
    "@t3-oss/env-core": "^0.13.11",
    "ajv": "^8.20.0",
    "better-auth": "^1.6.13",
    "better-auth-harmony": "^1.3.2",
    "cloudflare": "^6.3.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "fast-xml-parser": "^5.9.3",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "slugify": "^1.6.9",
    "sns-validator": "^0.3.5",
    "stripe": "^22.2.0",
    "typeid-js": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "latest",
    "@types/sns-validator": "^0.3.3",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.10"
  }
}
