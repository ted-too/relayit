    "@repo/contracts": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/logging": "workspace:*",
    "@repo/object-storage": "workspace:*",
    "@repo/persistence": "workspace:*",
    "@repo/provider-aws": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/templating": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typeid-js": "catalog:",
    "vitest": "catalog:"
  }
}
