{
  "name": "@repo/api",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./build --target node; cp -r ./drizzle ./build/drizzle;",
    "check-types": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@aws-sdk/client-ses": "^3.1027.0",
    "@aws-sdk/client-sns": "^3.1027.0",
    "@repo/shared": "workspace:*",
    "@repo/template-render": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "ajv": "^8.18.0",
    "better-auth": "^1.6.2",
    "better-auth-harmony": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "slugify": "^1.6.9",
    "typeid-js": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
