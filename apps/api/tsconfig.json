{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/api/*": ["./src/*"],
      "@repo/api": ["./src/index.ts"],
      "@repo/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
