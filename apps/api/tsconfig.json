{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "types": ["bun"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@repo/api/server": ["./src/server/index.ts"],
      "@repo/api/server/*": ["./src/server/*"],
      "@repo/api/worker": ["./src/worker/index.ts"],
      "@repo/api/worker/*": ["./src/worker/*"],
      "@repo/api/send": ["./src/shared/messages/send/index.ts"],
      "@repo/api/send/*": ["./src/shared/messages/send/*"],
      "@repo/api/*": ["./src/shared/*"]
    }
  }
}
