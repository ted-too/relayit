{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "types": ["bun"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@repo/api/*": ["./src/*"],
      "@repo/api/server": ["./src/server/index.ts"],
      "@repo/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
